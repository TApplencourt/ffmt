# Build and run the ffmt tests for one row of test/configs.json.
# Run it through the wrapper, which sources the setup script first:
#
#   test/run_id.sh 4          build and run id 4
#   test/run_id.sh 4 build    build only
#
# This file knows only the id. Modules, compiler and every compile flag
# (language standard and warnings included) come from
# test/setup/setup_<id>.sh, which must export CXX and FFMT_FLAGS, and may
# export the optional variables below. This file adds only its own
# mechanics: the include paths, -DFFMT_ID_<id> and the negative tests' two
# extra compiles.
#
# It only records what happened (exit statuses and logs); which failures
# are expected is judged by test/check_id.py, not here.
#
# Binaries, and make's own state (the status file of each compile, which
# is its target), go to build/id-<id>/; the config and the logs go to
# results/id-<id>/, which is what CI uploads and what one downloads a CI
# run into, so nothing make decides from may live there.

SHELL       := /bin/bash
.SHELLFLAGS := -o pipefail -c

ifndef id
  $(error usage: make -f Makefile.id id=N [test|build])
endif

SETUP := test/setup/setup_$(id).sh
OUT   := build/id-$(id)
LOGS  := results/id-$(id)

.DEFAULT_GOAL := test
.PHONY: test build

# CXX and FFMT_FLAGS come from the setup script.
ifndef FFMT_FLAGS
  $(error FFMT_FLAGS is not set: run test/run_id.sh $(id), which sources $(SETUP))
endif
ifeq ($(origin CXX),default)
  $(error $(SETUP) must export CXX)
endif

# Each test/test_<name>.cpp is one binary, so a new file needs no other edit.
SRCS  := $(wildcard test/test_*.cpp)
NAMES := $(patsubst test/test_%.cpp,%,$(SRCS))

# The reference is the pinned {fmt}. In third_party/fmt, the default, this
# file clones it and checks FMT_REF out again whenever the pin changes
# (FMT_PIN names the pin). A setup may point FMT_DIR at another checkout, on
# a machine without network: config.txt records the commit of the {fmt}
# used either way, and test/check_id.py refuses one that is not the pin.
FMT_REPO ?= https://github.com/fmtlib/fmt.git
FMT_REF  ?= 35c58f084e7cd79b51997439cff68346f4c724c0
FMT_DIR  ?= third_party/fmt
FMT_OBJ  := $(OUT)/fmt.o
ifeq ($(FMT_DIR),third_party/fmt)
  FMT_PIN := $(FMT_DIR)/.pinned-$(FMT_REF)
endif

INCLUDES := -Iinclude -isystem $(FMT_DIR)/include
# What every compile depends on.
HDRS     := $(wildcard test/*.hpp test/*.inc) include/ffmt/base.hpp $(FMT_PIN)

# Optional in the setup, for toolchains that need it:
#   FFMT_EXTRA_FILES   more programs to build and run (see extra)
#   FFMT_COMPILE_ONLY  compile each source and stop (see below)
#   FFMT_LDFLAGS       link flags, after the sources
#   FFMT_ORACLE_CXX    the host compiler that builds {fmt} (fmt.o and the
#                      negative tests' {fmt} pass), if CXX cannot
#   FFMT_TIMEOUT       seconds a program may run before it is killed, which
#                      test/check_id.py reads as a crash in the test it was in
FFMT_ORACLE_CXX ?= $(CXX)
FFMT_TIMEOUT    ?= 1800

# What differs with the compiler driver. clang and gcc: `-x none` ends a
# `-x cuda` of FFMT_FLAGS before fmt.o, and with -c clang warns that link
# flags such as -lcudart are unused, which -Werror would turn into a
# failure. nvcc has neither flag, and takes fmt.o for a source after its
# `-x cu` unless it goes straight to the linker.
ifeq ($(notdir $(CXX)),nvcc)
  LINK_FMT     := -Xlinker=$(FMT_OBJ)
  COMPILE_ONLY := -c
else
  LINK_FMT     := -x none $(FMT_OBJ)
  COMPILE_ONLY := -c -Wno-unused-command-line-argument
endif

# timeout(1) where there is one; macOS has none, and perl's alarm survives
# the exec. Either way the program dies of a signal.
TIMEOUT := $(shell command -v timeout >/dev/null 2>&1 \
  && echo "timeout --signal=TERM --kill-after=10s $(FFMT_TIMEOUT)s" \
  || echo "perl -e 'alarm shift; exec @ARGV' $(FFMT_TIMEOUT)")

$(FMT_PIN):
	[ -d $(FMT_DIR)/.git ] || git clone --quiet $(FMT_REPO) $(FMT_DIR)
	git -C $(FMT_DIR) checkout --quiet $(FMT_REF) 2>/dev/null \
	  || { git -C $(FMT_DIR) fetch --quiet origin && git -C $(FMT_DIR) checkout --quiet $(FMT_REF); }
	rm -f $(FMT_DIR)/.pinned-*; touch $@

$(OUT)/.dir:
	mkdir -p $(OUT) $(LOGS)
	touch $@

# The reference the tests compare against: {fmt}, built for the host the
# same way for every id (fixed standard, -O2, never fast-math, no -Werror on
# third-party code) so that every id is compared against the same thing,
# whatever its setup does to the tests. -fPIC: drivers that link PIE by
# default (ROCm 10 hipcc, chipStar) and those that do not can both use it.
$(FMT_OBJ): $(SETUP) $(FMT_PIN) | $(OUT)/.dir
	$(FFMT_ORACLE_CXX) -std=c++20 $(INCLUDES) -fno-fast-math -O2 -fPIC -c $(FMT_DIR)/src/format.cc -o $@

# What was built, with which compiler and for which goal, next to the logs.
# Rewritten on every run, so that it describes the logs beside it.
.PHONY: config
config: $(FMT_PIN) | $(OUT)/.dir
	@echo 'id=$(id) CXX=$(CXX) FFMT_FLAGS=$(FFMT_FLAGS)' | tee $(LOGS)/config.txt
	@# sed, not head: head exits after one line, and a compiler that prints
	@# more (ROCm 10 hipcc) dies of SIGPIPE, which pipefail turns into a failure.
	@$(CXX) --version | sed -n 1p | tee -a $(LOGS)/config.txt
	@echo "commit=$$(git describe --always --dirty --abbrev=40)" | tee -a $(LOGS)/config.txt
	@echo "goal=$(or $(filter build,$(MAKECMDGOALS)),test)" | tee -a $(LOGS)/config.txt
	@# safe.directory: a shared FMT_DIR (FFMT_RUNTIME_ROOT) belongs to another
	@# user, and git refuses to read it otherwise.
	@echo "fmt=$$(git -c safe.directory=$(abspath $(FMT_DIR)) -C $(FMT_DIR) rev-parse HEAD 2>/dev/null || echo unknown) pinned=$(FMT_REF)" | tee -a $(LOGS)/config.txt

# Negative tests: each test/negative/reject_*.cpp makes one format call that
# must not compile (accept_valid.cpp, the control, makes one that must, in
# all three ways). Every file is compiled three ways and each exit status
# recorded: with -DNEG_SYNTAX_CHECK, which makes the call a no-op (a file
# that still fails has a bug of its own, and its rejection means nothing);
# through {fmt} with -DNEG_CHECK_FMT (which must reject it too, or the
# restriction is one we invented); and plainly, through ffmt. The {fmt} compile is
# the same for every id, like fmt.o, and leaves out FFMT_FLAGS: {fmt}'s
# headers in an offload compile hit llvm/llvm-project#52699.
# Each file is its own target, so make -j compiles them in parallel.
NEG_DONE     := $(patsubst test/negative/%.cpp,$(OUT)/negative/%.status,$(wildcard test/negative/*.cpp))
NEG_COMPILE   = $(CXX) $(INCLUDES) $(FFMT_FLAGS) -DFFMT_ID_$(id) $(COMPILE_ONLY)
NEG_FMT       = $(FFMT_ORACLE_CXX) $(INCLUDES) -std=c++20 -Wall -Werror -DNEG_CHECK_FMT -c

$(OUT)/negative/%.status: test/negative/%.cpp $(HDRS) $(SETUP) | $(OUT)/.dir
	@mkdir -p $(@D)
	@{ $(NEG_COMPILE) -DNEG_SYNTAX_CHECK $< -o /dev/null >/dev/null 2>&1; echo "$$? syntax $*"; \
	   $(NEG_FMT) $< -o /dev/null >/dev/null 2>&1; echo "$$? fmt $*"; \
	   $(NEG_COMPILE) $< -o /dev/null >/dev/null 2>&1; echo "$$? ffmt $*"; } > $@

.PHONY: negative
negative: $(NEG_DONE)
	@cat $(NEG_DONE) | tee $(LOGS)/negative.log

# A compile-only id (FFMT_COMPILE_ONLY in the setup) is a toolchain that can
# compile for a device but not link for it (no device runtime installed):
# it compiles each source and stops, and has no test goal.
ifdef FFMT_COMPILE_ONLY
  TEST_OUT     = $(COMPILE_ONLY) -o /dev/null
  EXTRA_FLAGS := $(COMPILE_ONLY)
else
  TEST_OUT     = $(LINK_FMT) $(FFMT_LDFLAGS) -o $(OUT)/bin/$*
  TEST_DEPS   := $(FMT_OBJ)
  EXTRA_LINK  := $(FFMT_LDFLAGS)
endif

# Tests: each test/test_<name>.cpp is built as its own binary, so a file
# that does not compile, or a binary that crashes, takes down only its own
# tests. One status line per file and step goes to tests.log
# (`<exit status> build|run <name>`), each file's compiler output to
# <name>.build.log and its TAP output to <name>.run.log. The builds are
# separate targets and run in parallel under make -j: each one's target is
# its status line, in build/id-<id>/tests/ beside its compiler output, and
# build copies both to the logs.
TEST_DONE := $(patsubst %,$(OUT)/tests/%.build,$(NAMES))

$(OUT)/tests/%.build: test/test_%.cpp $(HDRS) $(SETUP) $(TEST_DEPS) | $(OUT)/.dir
	@mkdir -p $(@D) $(OUT)/bin
	@$(CXX) $(INCLUDES) $(FFMT_FLAGS) -DFFMT_ID_$(id) $< $(TEST_OUT) \
	  >$(@D)/$*.build.log 2>&1; echo "$$? build $*" > $@

# FFMT_EXTRA_FILES, optional in the setup: more programs, such as the README
# examples, built with the id's flags and run by the test goal. Not tests:
# test/check_id.py reports any that does not build or run. Same status
# lines as the tests, in extra.log.
.PHONY: extra
extra: | $(OUT)/.dir
	@mkdir -p $(OUT)/extra; for f in $(FFMT_EXTRA_FILES); do n=$$(basename $${f%.*}); \
	  $(CXX) $(INCLUDES) $(FFMT_FLAGS) $(EXTRA_FLAGS) $$f -o $(OUT)/extra/$$n $(EXTRA_LINK) \
	    >$(LOGS)/extra-$$n.log 2>&1; echo "$$? build $$n"; \
	done | tee $(LOGS)/extra.log

build: config negative extra $(TEST_DONE)
	@cp $(TEST_DONE:.build=.build.log) $(LOGS)/
	@cat $(TEST_DONE) | tee $(LOGS)/tests.log

ifdef FFMT_COMPILE_ONLY
test:
	@echo "Makefile.id: id $(id) is compile-only; use test/run_id.sh $(id) build" >&2; exit 1
else
# The builds run in parallel; the programs run one after another, here, so
# that two of them never share the GPU: each extra program and each test
# binary that built. TAP goes to stderr, hence 2>&1.
test: build
	@for n in $$(awk '$$1 == 0 { print $$3 }' $(LOGS)/extra.log); do \
	  $(TIMEOUT) ./$(OUT)/extra/$$n >>$(LOGS)/extra-$$n.log 2>&1; echo "$$? run $$n"; \
	done | tee -a $(LOGS)/extra.log
	@for n in $$(awk '$$1 == 0 { print $$3 }' $(LOGS)/tests.log); do \
	  $(TIMEOUT) ./$(OUT)/bin/$$n >$(LOGS)/$$n.run.log 2>&1; echo "$$? run $$n"; \
	done | tee -a $(LOGS)/tests.log
endif
